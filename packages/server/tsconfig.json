{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",           // Crucial for "type": "module"
    "moduleResolution": "NodeNext", // Crucial for "type": "module"
    "verbatimModuleSyntax": true,   // Keeps imports clean
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "include": ["src/**/*"]
}
